{
  "api_workers": 1,
  "monitor_workers": 1,
  "accounts_per_worker": 5,
  "worker_ports": {
    "api": [8000],
    "monitor": [8010]
  },
  "session_dir": "sessions",
  "log_dir": "logs",
  "database": {
    "pool_size": 20,
    "max_overflow": 30
  },
  "monitor": {
    "queue_maxsize": 2000,
    "batch_size": 50,
    "semaphore_limit": 10,
    "heartbeat_interval": 30,
    "startup_timeout": 5.0
  }
}
